---
import Layout from "../layouts/Layout.astro";
import { copyrightText } from "@zrr-website/site-meta";
import { existsSync } from "node:fs";
import { readdir } from "node:fs/promises";
import { join } from "node:path";

interface SlideMeta {
  title: string;
  date: string;
  event: string;
  description: string;
}

/** 每套幻灯片的展示元信息，key 为 hosting/slides/<slug> 目录名 */
const SLIDE_META: Record<string, SlideMeta> = {
  "open-source-innovation": {
    title: "开源创新大赛答辩",
    date: "2023-10",
    event: "中国软件开源创新大赛 · Paddle 开源任务挑战赛",
    description:
      "Python 层级运行时编译器系统：字节码分析、计算图优化与多后端执行，以及 PaddleSOT 的 Python 3.11 支持。",
  },
  "national-scholarship": {
    title: "国家奖学金答辩",
    date: "2021-05",
    event: "西安电子科技大学 人工智能学院",
    description: "学习成绩、综合素质、项目经历与荣誉奖项。",
  },
};

let slugs: string[] = [];
const hostingSlides = join(process.cwd(), "..", "..", "hosting", "slides");
const publicSlides = join(process.cwd(), "public", "slides");
const slidesDir = existsSync(hostingSlides) ? hostingSlides : publicSlides;
const items = await readdir(slidesDir, { withFileTypes: true });
slugs = items.filter(item => item.isDirectory()).map(item => item.name);

const coversDir = join(process.cwd(), "public", "covers");

const decks = slugs
  .map(slug => ({
    slug,
    meta: SLIDE_META[slug] ?? {
      title: slug,
      date: "",
      event: "",
      description: "",
    },
    cover: existsSync(join(coversDir, `${slug}.webp`))
      ? `/covers/${slug}.webp`
      : null,
  }))
  .sort((a, b) => b.meta.date.localeCompare(a.meta.date));
---

<Layout>
  <div class="flex min-h-svh flex-col bg-background text-foreground">
    <header class="border-b border-border">
      <div
        class="mx-auto flex max-w-4xl items-baseline justify-between px-5 py-4"
      >
        <a
          href="https://zrr.dev"
          class="mono text-sm font-semibold tracking-tight"
          rel="noopener noreferrer"
        >
          zrr<span class="text-foreground/50">.dev</span>
        </a>
        <nav class="mono flex gap-6 text-xs text-foreground/60">
          <a
            href="https://zrr.dev"
            class="nav-link"
            rel="noopener noreferrer">主站</a
          >
          <a
            href="https://blog.zrr.dev"
            class="nav-link"
            rel="noopener noreferrer">博客</a
          >
          <a
            href="https://github.com/zrr1999"
            class="nav-link"
            rel="noopener noreferrer">GitHub</a
          >
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-4xl flex-1 px-5 pt-14 pb-16">
      <h1 class="display-font text-4xl font-bold tracking-tight sm:text-5xl">
        幻灯片
      </h1>
      <p class="mt-3 text-foreground/60">
        技术演讲、课程分享，以及项目汇报的幻灯片合集。
      </p>

      <div class="mt-10">
        {
          decks.map(deck => (
            <a
              href={`/slides/${deck.slug}/index.html`}
              class="group grid gap-5 border-t border-border py-8 last:border-b md:grid-cols-[280px_1fr] md:items-center"
            >
              {deck.cover ? (
                <img
                  src={deck.cover}
                  alt={`${deck.meta.title} 封面`}
                  width="960"
                  height="540"
                  loading="lazy"
                  decoding="async"
                  class="aspect-video w-full rounded-lg border border-border object-cover"
                />
              ) : (
                <div class="display-font flex aspect-video w-full items-center justify-center rounded-lg border border-border bg-muted text-3xl font-bold text-foreground/40">
                  {deck.meta.title.slice(0, 1)}
                </div>
              )}
              <div>
                <p class="mono text-xs text-foreground/50">
                  {deck.meta.date}
                  {deck.meta.event && ` · ${deck.meta.event}`}
                </p>
                <h2 class="mt-2 text-2xl font-semibold tracking-tight transition-colors group-hover:text-accent">
                  {deck.meta.title}
                  <span
                    aria-hidden="true"
                    class="ml-2 inline-block text-foreground/40 transition-all duration-300 group-hover:translate-x-1 group-hover:text-accent"
                  >
                    →
                  </span>
                </h2>
                {deck.meta.description && (
                  <p class="mt-2 text-sm leading-relaxed text-foreground/60">
                    {deck.meta.description}
                  </p>
                )}
              </div>
            </a>
          ))
        }
      </div>
    </main>

    <footer class="w-full max-w-none border-t border-border px-0">
      <div
        class="mono mx-auto flex max-w-4xl items-baseline justify-between px-5 py-5 text-xs text-foreground/50"
      >
        <span>{copyrightText()}</span>
        <a
          href="https://zrr.dev"
          class="transition-colors hover:text-foreground"
          rel="noopener noreferrer">zrr.dev</a
        >
      </div>
    </footer>
  </div>
</Layout>

<style>
  .mono {
    font-family:
      "IBM Plex Mono",
      "Noto Sans SC",
      ui-monospace,
      monospace;
  }

  .display-font {
    font-family:
      "Space Grotesk",
      "Noto Sans SC",
      ui-sans-serif,
      system-ui,
      sans-serif;
  }

  .nav-link {
    position: relative;
    transition: color 0.25s ease;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link:hover {
    color: var(--foreground);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }
</style>
