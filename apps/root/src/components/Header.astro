---
const isAbout = Astro.url.pathname.replace(/\/+$/, "") === "/about";
---

<header
  class="fixed inset-x-0 top-0 z-10 border-b border-(--card-border) bg-(--bg)/85 backdrop-blur"
>
  <div
    class="mx-auto flex max-w-6xl items-baseline justify-between px-5 py-4 md:px-8"
  >
    <a href="/" class="mono text-sm font-semibold tracking-tight text-(--fg)">
      zrr<span class="text-(--subtle)">.dev</span>
    </a>
    <nav class="mono flex gap-5 text-xs text-(--muted) md:gap-7">
      <a
        class:list={["nav-link", { "text-(--fg)": isAbout }]}
        href="/about"
        aria-current={isAbout ? "page" : undefined}>关于</a
      >
      <a class="nav-link" id="rss-copy" href="https://blog.zrr.dev/rss.xml"
        >RSS</a
      >
    </nav>
  </div>
</header>

<div
  id="rss-toast"
  class="mono rss-toast fixed bottom-6 left-1/2 z-20 bg-(--fg) px-4 py-2 text-xs text-(--bg)"
  role="status"
  aria-live="polite"
>
</div>

<script>
  const rssLink = document.getElementById("rss-copy");
  const toast = document.getElementById("rss-toast");
  let toastTimer: ReturnType<typeof setTimeout> | undefined;

  async function copyText(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return true;
      }
      const textarea = document.createElement("textarea");
      textarea.value = text;
      document.body.appendChild(textarea);
      textarea.select();
      const ok = document.execCommand("copy");
      textarea.remove();
      return ok;
    } catch {
      return false;
    }
  }

  rssLink?.addEventListener("click", async event => {
    // 保留修饰键点击（新标签打开等）与右键菜单的原生行为
    if (
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    ) {
      return;
    }
    event.preventDefault();
    const ok = await copyText(rssLink.href);
    if (!toast) return;
    toast.textContent = ok ? "已复制 RSS 链接" : "复制失败，请右键复制链接";
    toast.classList.add("is-visible");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove("is-visible"), 2000);
  });
</script>

<style>
  .nav-link {
    position: relative;
    transition: color 0.25s ease;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link:hover {
    color: var(--fg);
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .rss-toast {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 8px);
    transition:
      opacity 0.25s ease,
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .rss-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .rss-toast {
      transition: none;
    }
  }
</style>
