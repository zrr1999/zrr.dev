---
export interface Props {
  name: string;
  description: string;
  href: string;
  tags?: string[];
}

const { name, description, href, tags = [] } = Astro.props;
---

<a
  href={href}
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-(--card-border) bg-(--card) p-6 shadow-[0_12px_40px_rgba(0,0,0,0.14)] backdrop-blur transition hover:-translate-y-1 hover:border-black/18 hover:bg-(--card-hover) dark:hover:border-white/18"
  target="_blank"
  rel="noopener noreferrer"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-20 -right-20 h-48 w-48 rounded-full bg-[radial-gradient(circle_at_30%_30%,rgba(43,89,255,0.28),transparent_70%)] opacity-0 transition-opacity duration-300 group-hover:opacity-100 dark:bg-[radial-gradient(circle_at_30%_30%,rgba(120,166,255,0.45),transparent_70%)]"
  >
  </div>

  <div class="mb-3 flex items-start justify-between gap-3">
    <h3 class="text-xl font-semibold tracking-tight text-(--fg)">
      <span class="display-font">{name}</span>
    </h3>
    <span
      class="mt-1 shrink-0 text-(--subtle) transition-transform duration-200 group-hover:translate-x-0.5"
      aria-hidden="true">→</span
    >
  </div>

  <p class="flex-1 text-sm leading-relaxed text-(--muted)">
    {description}
  </p>

  {
    tags.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2">
        {tags.map(tag => (
          <li class="rounded-full border border-black/10 bg-black/4 px-2.5 py-0.5 text-xs text-(--subtle) dark:border-white/10 dark:bg-white/5">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</a>

<style>
  a {
    text-decoration: none;
  }
</style>
