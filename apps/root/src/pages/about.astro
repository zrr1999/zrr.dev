---
import Layout from "@/components/Layout.astro";
import Header from "@/components/Header.astro";
import PageContent from "@/components/PageContent.astro";
import BentoGrid from "@/components/BentoGrid.astro";
import BentoCell from "@/components/BentoCell.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { SITE_AUTHOR } from "@zrr-website/site-meta";
import {
  vision,
  background,
  currentRole,
  school,
  researchDirections,
  experiences,
} from "@/profile";

const contacts = [
  { name: "GitHub", href: "https://github.com/zrr1999", note: "zrr1999" },
  { name: "邮箱", href: "mailto:me@zrr.dev", note: "me@zrr.dev" },
  { name: "博客", href: "https://blog.zrr.dev", note: "blog.zrr.dev" },
  { name: "RSS", href: "https://blog.zrr.dev/rss.xml", note: "订阅最新文章" },
];

const upstream = [
  "pytorch/pytorch",
  "huggingface/transformers",
  "flet-dev/flet",
  "astral-sh/uv",
  "lepture/mistune",
];
const heading = "关于";
---

<Layout
  title={`关于 — ${SITE_AUTHOR}`}
  description={`关于${SITE_AUTHOR}。${vision}`}
  serifText={heading}
>
  <Header />

  <PageContent>
    <BentoGrid>
      <BentoCell
        tone="tint"
        span="col-span-1 md:col-span-6 lg:col-span-8"
        delay={0}
      >
        <h1 class="bento-title">{heading}</h1>
        <p class="bento-lede bento-muted mt-4 max-w-2xl">
          嗨，我是{SITE_AUTHOR}。现在在{currentRole.org}做{currentRole.group}研发，也持续构建自己的编程语言、深度学习框架和智能体系统。{background}
        </p>
        <p class="mono mt-5 flex flex-wrap gap-x-5 gap-y-2 text-xs text-(--subtle)">
          <span>{currentRole.org} {currentRole.group}</span>
          <span>{currentRole.community}</span>
          <span>{school} 计算机硕士</span>
        </p>
      </BentoCell>

      <BentoCell
        tone="plain"
        label="联系"
        span="col-span-1 md:col-span-6 lg:col-span-4"
        delay={1}
      >
        <div class="flex flex-1 flex-col">
          {
            contacts.map(contact => (
              <a
                href={contact.href}
                class="flex items-baseline justify-between gap-4 border-t border-(--card-border) py-3 first:border-t-0 first:pt-0 last:pb-0"
              >
                <span class="text-[15px] font-medium">{contact.name}</span>
                <span class="mono text-xs text-(--subtle)">{contact.note}</span>
              </a>
            ))
          }
        </div>
      </BentoCell>

      {
        researchDirections.map((direction, index) => {
          const last = index === researchDirections.length - 1;
          return (
            <BentoCell
              id={index === 0 ? "research" : undefined}
              tone={last ? "accent" : "plain"}
              span={
                last
                  ? "col-span-1 md:col-span-6 lg:col-span-12"
                  : index === 0
                    ? "col-span-1 md:col-span-6 lg:col-span-7"
                    : "col-span-1 md:col-span-6 lg:col-span-5"
              }
              delay={2 + index}
            >
              <h2 class="bento-heading">{direction.title}</h2>
              <p class="mt-3 text-base leading-relaxed">{direction.question}</p>
              <p class="bento-muted mt-3 text-sm leading-relaxed">{direction.detail}</p>
            </BentoCell>
          );
        })
      }

      <BentoCell
        tone="tint"
        label="经历"
        span="col-span-1 md:col-span-6 lg:col-span-7"
        delay={5}
      >
        {
          experiences.map(item => (
            <div class="border-t border-(--card-border) py-4 first:border-t-0 first:pt-0 last:pb-0">
              <p class="mono text-xs text-(--subtle)">{item.period}</p>
              <p class="mt-1 text-[15px] font-medium">{item.title}</p>
              <p class="bento-muted mt-1 text-sm leading-relaxed">{item.detail}</p>
            </div>
          ))
        }
      </BentoCell>

      <BentoCell
        tone="plain"
        label="开源"
        span="col-span-1 md:col-span-6 lg:col-span-5"
        delay={6}
      >
        <p class="bento-muted text-sm leading-relaxed">
          习惯把工作和研究中遇到的问题修回上游。个人项目见<a
            href="/#projects"
            class="text-(--fg) underline decoration-(--card-border) underline-offset-4 hover:text-(--accent)"
            >主页项目</a
          >或 <a
            href="https://github.com/zrr1999"
            class="text-(--fg) underline decoration-(--card-border) underline-offset-4 hover:text-(--accent)"
            >GitHub</a
          >。
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            upstream.map(repo => (
              <a href={`https://github.com/${repo}`} class="chip mono">
                {repo}
              </a>
            ))
          }
        </div>
      </BentoCell>

      <BentoCell
        tone="plain"
        label="本站"
        span="col-span-1 md:col-span-6 lg:col-span-12"
        delay={7}
      >
        <p class="max-w-2xl text-sm leading-relaxed text-(--muted)">
          本站使用 Astro 与 Vite+ 构建，正文字体为 Noto Sans SC，标题与等宽字体为
          Space Grotesk 与 IBM Plex Mono；源码开源于 <a
            href="https://github.com/zrr1999/zrr.dev"
            class="text-(--fg) underline decoration-(--card-border) underline-offset-4 hover:text-(--accent)"
            >zrr1999/zrr.dev</a
          >。
        </p>
      </BentoCell>
    </BentoGrid>

    <SiteFooter showHome />
  </PageContent>
</Layout>
