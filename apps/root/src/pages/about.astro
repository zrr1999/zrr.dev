---
import Layout from "@/components/Layout.astro";
import Header from "@/components/Header.astro";
import PageContent from "@/components/PageContent.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { SITE_AUTHOR, copyrightText } from "@zrr-website/site-meta";
import { vision, background, researchDirections } from "@/profile";

const experiences = [
  {
    period: "2025–至今",
    title: "百度 · 大模型预训练部",
    detail: "飞桨基础框架研发，负责正确性与生态兼容方向。",
  },
  {
    period: "2023–2025",
    title: "百度 · 飞桨基础框架（实习）",
    detail: "参与 PIR 新一代 IR 体系与 SOT 动转静架构研发。",
  },
  {
    period: "2023",
    title: "PaddlePaddle 社区 Committer",
    detail: "通过多期黑客松的算子与编译器贡献，成为社区第五位 Committer。",
  },
];

const contacts = [
  { name: "GitHub", href: "https://github.com/zrr1999", note: "zrr1999" },
  { name: "邮箱", href: "mailto:me@zrr.dev", note: "me@zrr.dev" },
  { name: "博客", href: "https://blog.zrr.dev", note: "blog.zrr.dev" },
  { name: "RSS", href: "https://blog.zrr.dev/rss.xml", note: "订阅最新文章" },
];
---

<Layout
  title={`关于 — ${SITE_AUTHOR}`}
  description={`关于${SITE_AUTHOR}。${vision}`}
  ambient={false}
>
  <Header />

  <PageContent>
    <section class="reveal">
      <h1
        class="display-font text-[clamp(3rem,10vw,7.5rem)] leading-[0.95] font-bold tracking-[-0.03em] text-(--fg) uppercase"
      >
        关于<span class="text-(--accent)"> / About</span>
      </h1>
      <p
        class="mt-8 max-w-2xl text-base leading-relaxed text-(--muted) md:text-lg"
      >
        嗨，我是{SITE_AUTHOR}。现在在百度做飞桨基础框架研发，也持续构建自己的编程语言、深度学习框架和智能体系统。{background}
      </p>
      <p
        class="mono mt-6 flex flex-wrap gap-x-5 gap-y-2 text-xs text-(--subtle)"
      >
        <span><span class="text-(--accent)">@</span> 百度 · 飞桨基础框架</span>
        <span>PaddlePaddle Committer</span>
        <span>西安电子科技大学 · 计算机硕士</span>
      </p>
    </section>

    <section id="research" class="reveal reveal-2 mt-20 scroll-mt-24 md:mt-24">
      <SectionHeading>研究方向 / Research</SectionHeading>
      <p class="mt-5 max-w-3xl text-xl leading-relaxed text-(--fg) md:text-2xl">
        {vision}
      </p>
      <div class="mt-6">
        {
          researchDirections.map(direction => (
            <div class="grid gap-3 border-t border-(--card-border) py-6 last:border-b md:grid-cols-[200px_1fr] md:gap-8">
              <h3 class="text-base font-semibold text-(--fg)">{direction.title}</h3>
              <div class="max-w-2xl">
                <p class="text-base leading-relaxed text-(--fg)">{direction.question}</p>
                <p class="mt-3 text-sm leading-relaxed text-(--muted)">{direction.detail}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="reveal reveal-2 mt-20 md:mt-24">
      <SectionHeading>经历 / Path</SectionHeading>

      <div class="mt-4">
        {
          experiences.map(e => (
            <div class="grid grid-cols-[1fr_auto] items-baseline gap-2 border-t border-(--card-border) py-6 last:border-b md:grid-cols-[140px_1fr] md:gap-6">
              <span class="mono col-span-2 text-xs text-(--subtle) md:col-span-1">
                {e.period}
              </span>
              <div>
                <p class="text-[15px] font-medium text-(--fg)">{e.title}</p>
                <p class="mt-1 text-sm text-(--muted)">{e.detail}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="reveal reveal-3 mt-20 md:mt-24">
      <SectionHeading>开源 / Open Source</SectionHeading>
      <p
        class="mt-4 max-w-2xl border-t border-(--card-border) pt-5 text-sm leading-relaxed text-(--muted)"
      >
        习惯把工作和研究中遇到的问题修回上游：在 pytorch/pytorch、
        huggingface/transformers、flet-dev/flet、astral-sh/uv、lepture/mistune
        等仓库均有合入；个人项目见
        <a
          href="/#projects"
          class="text-(--fg) underline decoration-(--subtle) underline-offset-4 transition-colors hover:text-(--accent)"
          >主页项目索引</a
        >
        或
        <a
          href="https://github.com/zrr1999"
          class="text-(--fg) underline decoration-(--subtle) underline-offset-4 transition-colors hover:text-(--accent)"
          >GitHub</a
        >。
      </p>
    </section>

    <section class="reveal reveal-3 mt-20 md:mt-24">
      <SectionHeading>本站 / Colophon</SectionHeading>
      <p
        class="mt-4 max-w-2xl border-t border-(--card-border) pt-5 text-sm leading-relaxed text-(--muted)"
      >
        本站使用 Astro 与 Vite+ 构建，正文字体为 Noto Sans SC，标题与等宽字体为
        Space Grotesk 与 IBM Plex Mono；源码开源于
        <a
          href="https://github.com/zrr1999/zrr.dev"
          class="text-(--fg) underline decoration-(--subtle) underline-offset-4 transition-colors hover:text-(--accent)"
          >zrr1999/zrr.dev</a
        >。
      </p>
    </section>

    <section class="reveal reveal-3 mt-20 md:mt-24">
      <SectionHeading>联系 / Find me</SectionHeading>

      <div class="mt-4">
        {
          contacts.map(c => (
            <a
              href={c.href}
              class="group grid grid-cols-[1fr_auto] items-baseline gap-6 border-t border-(--card-border) py-4 transition-[padding] duration-300 last:border-b hover:pl-4"
            >
              <span class="flex items-baseline gap-6">
                <span class="text-[15px] font-medium text-(--fg) transition-colors duration-300 group-hover:text-(--accent)">
                  {c.name}
                </span>
                <span class="mono text-xs text-(--subtle)">{c.note}</span>
              </span>
              <span
                class="text-sm text-(--subtle) transition-all duration-300 group-hover:translate-x-1 group-hover:text-(--accent)"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <footer
      class="mono mt-24 flex flex-wrap items-baseline justify-between gap-3 border-t border-(--card-border) pt-6 text-xs text-(--subtle)"
    >
      <span>{copyrightText()}</span>
      <span>
        <a href="/" class="transition-colors hover:text-(--fg)">首页</a>
        <span class="mx-2">·</span>
        <a
          href="https://github.com/zrr1999"
          class="transition-colors hover:text-(--fg)">GitHub</a
        >
      </span>
    </footer>
  </PageContent>
</Layout>
