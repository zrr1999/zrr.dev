---
import Layout from "@/components/Layout.astro";
import Header from "@/components/Header.astro";
import PageContent from "@/components/PageContent.astro";
import BentoGrid from "@/components/BentoGrid.astro";
import BentoCell from "@/components/BentoCell.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { SITE_AUTHOR } from "@zrr-website/site-meta";
import { friends } from "@/friends";
import {
  vision,
  currentRole,
  school,
  education,
  researchDirections,
  researchDirection,
} from "@/profile";
import { spore, spark, volvox } from "@/projects";
import { fetchRecentPosts } from "@/lib/recentPosts";

const avatarSrc =
  "https://raw.githubusercontent.com/zrr1999/hosting/main/images/profile/personal/avatar.png";

const sites = [
  {
    name: "博客",
    domain: "blog.zrr.dev",
    href: "https://blog.zrr.dev",
    description: "学习笔记、技术文章和项目经验。",
  },
  {
    name: "幻灯片",
    domain: "slides.zrr.dev",
    href: "https://slides.zrr.dev",
    description: "技术演讲、课程分享，以及项目汇报的幻灯片合集。",
  },
  {
    name: "GitHub",
    domain: "github.com/zrr1999",
    href: "https://github.com/zrr1999",
    description: "开源项目、代码贡献和一些实验性质的仓库。",
  },
];

const posts = await fetchRecentPosts();
const sporeSample = spore.sample ?? "";
---

<Layout description={`${SITE_AUTHOR}的个人网站。${vision}`}>
  <Header />

  <PageContent>
    <BentoGrid>
      <BentoCell
        tone="tint"
        span="bento-order-identity col-span-1 md:col-span-6 lg:col-span-8 lg:row-span-2"
        delay={0}
      >
        <div class="flex items-center gap-4">
          <div class="shrink-0 rounded-2xl bg-white p-1">
            <img
              src={avatarSrc}
              alt={`${SITE_AUTHOR}的头像`}
              width="80"
              height="80"
              class="size-20 rounded-[0.9rem]"
            />
          </div>
          <p class="mono text-xs tracking-wide text-(--muted)">
            {SITE_AUTHOR} / zrr1999
          </p>
        </div>
        <h1
          aria-label="Zhan Rongrui"
          class="display-font mt-6 text-[clamp(2.6rem,6vw,4.75rem)] leading-[0.95] font-bold tracking-[-0.035em] uppercase"
        >
          <span class="hero-line"><span>Zhan</span></span>
          <span class="hero-line hero-line--accent">
            <span>Rongrui</span>
          </span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed md:text-xl">
          {vision}
        </p>
        <div class="mt-auto flex flex-wrap items-center gap-x-6 pt-6">
          <a href="/about" class="text-link font-medium">关于我</a>
          <a href="/about#research" class="text-link text-(--muted)">
            研究方向
          </a>
        </div>
      </BentoCell>

      <BentoCell
        tone="plain"
        span="bento-order-now col-span-1 md:col-span-6 lg:col-span-4"
        delay={1}
      >
        <p class="text-sm font-medium">{currentRole.org}</p>
        <p class="mt-1 text-lg font-semibold tracking-tight">
          {currentRole.group}
        </p>
        <p class="bento-muted mt-1 text-sm">{currentRole.detail}</p>
        <p class="mt-4 text-sm">{currentRole.community}</p>
        <div class="mt-auto pt-6">
          <p class="text-sm font-medium">{school}</p>
          {
            education.map(item => (
              <p class="mt-2 flex items-baseline justify-between gap-3 text-sm">
                <span>
                  <span class="mr-2 text-(--accent)">{item.degree}</span>
                  {item.major}
                </span>
                <span class="mono text-xs text-(--subtle)">{item.years}</span>
              </p>
            ))
          }
        </div>
      </BentoCell>

      <BentoCell
        tone="plain"
        span="bento-order-sites col-span-1 md:col-span-6 lg:col-span-4"
        delay={2}
      >
        <div class="flex h-full flex-col justify-between gap-4">
          {
            sites.map(site => (
              <a href={site.href} class="group min-w-0">
                <p class="flex flex-wrap items-baseline gap-x-3">
                  <span class="display-font text-xl font-bold tracking-tight group-hover:text-(--accent)">
                    {site.name}
                  </span>
                  <span class="mono text-xs break-all text-(--subtle)">
                    {site.domain}
                  </span>
                </p>
                <p class="bento-muted mt-1 text-sm leading-relaxed">
                  {site.description}
                </p>
              </a>
            ))
          }
        </div>
      </BentoCell>

      <BentoCell
        href="/about#research"
        tone="accent"
        label="研究方向"
        span="bento-order-research col-span-1 md:col-span-6 lg:col-span-4 lg:row-span-2"
        delay={3}
      >
        <div class="flex h-full flex-col gap-5">
          {
            researchDirections.map(direction => (
              <div>
                <p class="text-base font-semibold">{direction.title}</p>
                <p class="bento-muted mt-1 text-sm leading-relaxed">
                  {direction.id === "self-improvement"
                    ? "开放方向"
                    : direction.question}
                </p>
              </div>
            ))
          }
          <p class="mt-auto pt-2 text-sm font-medium">了解研究方向 →</p>
        </div>
      </BentoCell>

      <BentoCell
        id="projects"
        href={spore.href}
        tone="tint"
        span="bento-order-project col-span-1 md:col-span-6 lg:col-span-8"
        delay={4}
      >
        <p class="bento-muted text-xs">
          {researchDirection(spore.direction).title}
        </p>
        <h2 class="display-font mt-3 text-4xl font-bold tracking-tight md:text-5xl">
          {spore.name}
        </h2>
        <p class="bento-muted mt-3 max-w-2xl text-sm leading-relaxed">
          {spore.description}
        </p>
        <pre class="code-sample mono mt-5">{sporeSample}</pre>
        <p class="mono bento-muted mt-auto flex items-baseline justify-between gap-3 pt-5 text-xs">
          <span>{spore.tags.join(" / ")}</span>
          <span aria-hidden="true">↗</span>
        </p>
      </BentoCell>

      <BentoCell
        href={spark.href}
        tone="plain"
        span="bento-order-project col-span-1 md:col-span-3 lg:col-span-4"
        delay={5}
      >
        <p class="bento-muted text-xs">
          {researchDirection(spark.direction).title}
        </p>
        <h2 class="display-font mt-3 text-3xl font-bold tracking-tight">
          {spark.name}
        </h2>
        <p class="bento-muted mt-3 text-sm leading-relaxed">
          {spark.description}
        </p>
        <p class="mono bento-muted mt-auto flex items-baseline justify-between gap-3 pt-5 text-xs">
          <span>{spark.tags.join(" / ")}</span>
          <span aria-hidden="true">↗</span>
        </p>
      </BentoCell>

      <BentoCell
        href={volvox.href}
        tone="plain"
        span="bento-order-project col-span-1 md:col-span-3 lg:col-span-4"
        delay={6}
      >
        <p class="bento-muted text-xs">
          {researchDirection(volvox.direction).title}
        </p>
        <h2 class="display-font mt-3 text-3xl font-bold tracking-tight">
          {volvox.name}
        </h2>
        <p class="bento-muted mt-3 text-sm leading-relaxed">
          {volvox.description}
        </p>
        <p class="mono bento-muted mt-auto flex items-baseline justify-between gap-3 pt-5 text-xs">
          <span>{volvox.tags.join(" / ")}</span>
          <span aria-hidden="true">↗</span>
        </p>
      </BentoCell>

      <BentoCell
        id="writing"
        tone="tint"
        label="最近文章"
        span="bento-order-writing col-span-1 md:col-span-6 lg:col-span-8"
        delay={7}
      >
        {
          posts.length > 0 ? (
            <div class="flex flex-1 flex-col">
              {posts.map(post => (
                <a
                  href={post.href}
                  class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-3 border-t border-(--card-border) py-3 first:border-t-0 first:pt-0 last:pb-0 md:grid-cols-[7.5rem_minmax(0,1fr)_auto] md:gap-4"
                >
                  {post.date ? (
                    <time
                      datetime={post.date}
                      class="mono col-span-2 text-xs text-(--subtle) md:col-span-1"
                    >
                      {post.date}
                    </time>
                  ) : (
                    <span class="hidden md:block" aria-hidden="true" />
                  )}
                  <span class="text-[15px] leading-relaxed font-medium">
                    {post.title}
                  </span>
                  <span class="text-(--subtle)" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <p class="bento-muted text-sm leading-relaxed">
              这里记录编程语言、AI 系统与工程实践。
            </p>
          )
        }
        <a
          href="https://blog.zrr.dev"
          class="text-link mono mt-4 self-start text-xs text-(--muted)"
        >
          所有文章 <span aria-hidden="true">↗</span>
        </a>
      </BentoCell>

      <BentoCell
        tone="plain"
        label="友链"
        span="bento-order-friends col-span-1 md:col-span-6 lg:col-span-4"
        delay={8}
      >
        <div class="flex flex-1 flex-col gap-3">
          {
            friends.map(friend => (
              <a href={friend.url} class="text-link min-h-0 py-1 text-(--fg)">
                {friend.name}
              </a>
            ))
          }
        </div>
        <a
          href="/friends#exchange"
          class="text-link mt-4 self-start text-sm text-(--muted)"
        >
          互换友链
        </a>
      </BentoCell>
    </BentoGrid>

    <SiteFooter />
  </PageContent>
</Layout>
