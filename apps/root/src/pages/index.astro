---
import Layout from "@/components/Layout.astro";
import Header from "@/components/Header.astro";
import RssCopy from "@/components/RssCopy";
import PageContent from "@/components/PageContent.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { SITE_AUTHOR, copyrightText } from "@zrr-website/site-meta";
import { friends } from "@/friends";
import { vision, researchFocus, background } from "@/profile";

const sites = [
  {
    name: "博客",
    domain: "blog.zrr.dev",
    href: "https://blog.zrr.dev",
    description: "学习笔记、技术文章和项目经验。",
  },
  {
    name: "幻灯片",
    domain: "slides.zrr.dev",
    href: "https://slides.zrr.dev",
    description: "技术演讲、课程分享，以及项目汇报的幻灯片合集。",
  },
  {
    name: "GitHub",
    domain: "github.com/zrr1999",
    href: "https://github.com/zrr1999",
    description: "开源项目、代码贡献和一些实验性质的仓库。",
  },
];

// 这里只决定首页的展示层级，不承担 Lab / Docs 的项目登记与路由。
const projects = [
  {
    name: "spark",
    focus: "执行 / Agent infrastructure",
    description:
      "让智能体工作跨越一次终端会话：本地 daemon 托管会话、执行与恢复，支撑长期任务与跨工作区委托。",
    href: "https://github.com/zendev-lab/spark",
    tags: ["TypeScript", "Agent"],
  },
  {
    name: "spore",
    focus: "表达 / Programming language",
    description:
      "意图编程语言（实验阶段）：用函数签名表达类型、可失败结果与 effect，以 hole 承载尚未完成的实现，让人和智能体在同一份约束上协作。",
    href: "https://github.com/spore-lang/spore",
    tags: ["Rust", "Language"],
  },
  {
    name: "volvox",
    focus: "学习 / Deep learning framework",
    description:
      "可组合深度学习元框架（探索阶段）：在早期框架实验基础上，研究组件边界、依赖与执行语义，以及替换组件后需要保持和验证的性质。",
    href: "https://github.com/volvox-ai/volvox",
    tags: ["Python", "DL Framework"],
  },
];

const supportingProjects = [
  {
    name: "cue",
    kind: "执行工具",
    description:
      "持久、可观察的命令执行底座，让人和智能体共享执行状态，支持断线恢复、共享 session 与多观察者 PTY。",
    href: "https://github.com/zendev-lab/cue",
  },
  {
    name: "emotion-recognition",
    kind: "早期作品",
    description:
      "多模态情绪识别系统（硕士毕业设计），覆盖文本、音频、视频三模态的情绪分类与情感分析。",
    href: "https://github.com/zrr1999/emotion-recognition",
  },
];

const education = [
  { degree: "学士", major: "智能科学与技术", years: "2018–2022" },
  { degree: "硕士", major: "计算机科学与技术", years: "2022–2025" },
];

interface Post {
  title: string;
  href: string;
  date: string;
}

/** 构建期读取博客 RSS；限时失败降级，页面仍保留博客入口。 */
async function fetchRecentPosts(limit = 4): Promise<Post[]> {
  try {
    const res = await fetch("https://blog.zrr.dev/rss.xml", {
      signal: AbortSignal.timeout(5000),
    });
    if (!res.ok) return [];
    const xml = await res.text();
    const pick = (item: string, tag: string) =>
      item.match(new RegExp(`<${tag}>([\\s\\S]*?)</${tag}>`))?.[1]?.trim() ??
      "";
    return [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)]
      .slice(0, limit)
      .map(m => {
        const item = m[1];
        const d = new Date(pick(item, "pubDate"));
        return {
          title: pick(item, "title"),
          href: pick(item, "link"),
          date: Number.isNaN(d.getTime()) ? "" : d.toISOString().slice(0, 10),
        };
      })
      .filter(p => p.title && p.href);
  } catch {
    return [];
  }
}

const posts = await fetchRecentPosts();
---

<Layout description={`${SITE_AUTHOR}的个人网站。${vision}`} ambient={false}>
  <Header />

  <PageContent>
    <section class="reveal">
      <div class="grid items-end gap-10 lg:grid-cols-[minmax(0,1fr)_250px]">
        <div class="min-w-0">
          <p class="mono mb-5 text-xs tracking-wide text-(--muted)">
            {SITE_AUTHOR} / zrr1999
          </p>
          <h1
            aria-label="Zhan Rongrui"
            class="display-font text-[clamp(3rem,12vw,9rem)] leading-[0.98] font-bold tracking-[-0.035em] text-(--fg) uppercase"
          >
            <span class="hero-line"><span>Zhan</span></span>
            <span class="hero-line hero-line--accent text-right">
              <span>Rongrui</span>
            </span>
          </h1>
          <p class="mt-8 text-sm font-medium text-(--accent)">
            {researchFocus}
          </p>
          <p class="mt-4 max-w-2xl text-xl leading-relaxed text-(--fg) md:text-2xl">
            {vision}
          </p>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-(--muted) md:text-base">
            {background}
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
            <a href="#projects" class="text-link font-medium">
              探索项目 <span aria-hidden="true">↓</span>
            </a>
            <a href="/about#research" class="text-link text-(--muted)">
              研究方向与经历 <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <aside class="mono text-xs leading-loose text-(--muted)" aria-label="教育经历">
          <span
            class="mb-3 block text-[11px] tracking-[0.14em] text-(--subtle) uppercase"
          >
            Education
          </span>
          <p class="mb-2 text-sm font-semibold tracking-wide text-(--fg)">
            西安电子科技大学
          </p>
          {
            education.map(e => (
              <p class="flex items-baseline justify-between gap-3">
                <span>
                  <span class="mr-2 text-(--accent)">{e.degree}</span>
                  {e.major}
                </span>
                <span class="text-(--subtle)">{e.years}</span>
              </p>
            ))
          }
        </aside>
      </div>
    </section>

    <section id="projects" class="reveal reveal-2 mt-16 md:mt-20">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <SectionHeading>代表项目 / Selected work</SectionHeading>
        <a href="https://github.com/zrr1999" class="text-link mono text-xs text-(--muted)">
          更多代码 <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-(--muted)">
        从执行、表达与学习三个方向，探索可组合、可验证的计算系统。
      </p>

      <ul class="project-grid mt-6">
        {
          projects.map(project => (
            <li>
              <a
                href={project.href}
                class="project-card"
                aria-labelledby={`project-${project.name}-title`}
                aria-describedby={`project-${project.name}-description`}
              >
                <p class="mono text-xs leading-relaxed text-(--muted)">{project.focus}</p>
                <h3
                  id={`project-${project.name}-title`}
                  class="display-font mt-4 text-4xl font-bold tracking-tight"
                >
                  {project.name}
                </h3>
                <p
                  id={`project-${project.name}-description`}
                  class="mt-4 text-sm leading-relaxed text-(--muted)"
                >
                  {project.description}
                </p>
                <span class="project-meta mono text-xs text-(--muted)">
                  <span>{project.tags.join(" / ")}</span>
                  <span class="text-lg" aria-hidden="true">↗</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-8 text-sm font-medium text-(--fg)">工具与早期工作</h3>
      <div class="mt-3">
        {
          supportingProjects.map(project => (
            <a href={project.href} class="supporting-project">
              <div class="min-w-0">
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  <span class="mono project-name text-base font-semibold text-(--fg)">{project.name}</span>
                  <span class="text-xs text-(--muted)">{project.kind}</span>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-(--muted)">{project.description}</p>
              </div>
              <span aria-hidden="true" class="text-(--muted)">↗</span>
            </a>
          ))
        }
      </div>
    </section>

    <section id="writing" class="reveal reveal-3 mt-16 md:mt-20">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <SectionHeading>最近文章 / Writing</SectionHeading>
        <a href="https://blog.zrr.dev" class="text-link mono text-xs text-(--muted)">
          所有文章 <span aria-hidden="true">↗</span>
        </a>
      </div>

      {
        posts.length > 0 ? (
          <div class="mt-4">
            {posts.map(post => (
              <a
                href={post.href}
                class="writing-row grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-3 gap-y-2 border-t border-(--card-border) py-5 last:border-b md:grid-cols-[120px_minmax(0,1fr)_auto] md:gap-6"
              >
                {post.date ? (
                  <time datetime={post.date} class="mono col-span-2 text-xs text-(--muted) md:col-span-1">
                    {post.date}
                  </time>
                ) : (
                  <span class="hidden md:block" aria-hidden="true" />
                )}
                <span class="post-title text-[15px] leading-relaxed font-medium text-(--fg)">{post.title}</span>
                <span class="text-sm text-(--muted)" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="mt-4 border-y border-(--card-border) py-6 text-sm leading-relaxed text-(--muted)">
            这里记录编程语言、AI 系统与工程实践。
            <a href="https://blog.zrr.dev" class="text-link">到博客阅读全部文章 <span aria-hidden="true">↗</span></a>
          </p>
        )
      }
    </section>

    <section id="elsewhere" class="reveal reveal-3 mt-16 md:mt-20">
      <SectionHeading>站点 / Elsewhere</SectionHeading>
      <div class="mt-4">
        {
          sites.map(site => (
            <a href={site.href} class="site-row">
              <div class="min-w-0">
                <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
                  <span class="display-font site-name text-2xl font-bold tracking-tight text-(--fg)">{site.name}</span>
                  <span class="mono text-xs break-all text-(--muted)">{site.domain}</span>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-(--muted)">{site.description}</p>
              </div>
              <span class="text-xl text-(--muted)" aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="reveal reveal-3 mt-16 md:mt-20">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <SectionHeading>友链 / Friends</SectionHeading>
        <a href="/friends#exchange" class="text-link mono text-xs text-(--muted)">
          互换友链 <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="mt-4 flex flex-wrap items-baseline gap-x-5 gap-y-1 border-t border-(--card-border) pt-4 text-sm">
        {
          friends.map(friend => (
            <a href={friend.url} class="text-link text-(--muted)">{friend.name}</a>
          ))
        }
      </p>
    </section>

    <footer class="mono mt-20 flex flex-wrap items-baseline justify-between gap-3 border-t border-(--card-border) pt-6 text-xs text-(--subtle)">
      <span>{copyrightText()}</span>
      <div class="flex items-center">
        <RssCopy client:load />
        <span class="mx-2" aria-hidden="true">·</span>
        <a href="https://github.com/zrr1999" class="text-link">GitHub</a>
      </div>
    </footer>
  </PageContent>
</Layout>

<style>
  section[id] {
    scroll-margin-top: 7rem;
  }

  .hero-line {
    display: block;
    overflow: hidden;
  }

  .hero-line > span {
    display: block;
    animation: hero-rise 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-line--accent > span {
    color: var(--accent);
    animation-delay: 0.12s;
  }

  @keyframes hero-rise {
    from {
      transform: translateY(110%);
    }
    to {
      transform: translateY(0);
    }
  }

  .text-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    text-underline-offset: 0.3em;
    transition: color 150ms ease;
  }

  .text-link:hover,
  .text-link:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }

  .project-grid {
    display: grid;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--card-border);
  }

  .project-grid > li + li {
    border-top: 1px solid var(--card-border);
  }

  .project-card {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    padding: 1.5rem 1rem;
    transition: background-color 150ms ease;
  }

  .project-card:hover,
  .project-card:focus-visible {
    background: var(--card);
  }

  .project-card:hover h3,
  .project-card:focus-visible h3,
  .supporting-project:hover .project-name,
  .supporting-project:focus-visible .project-name,
  .site-row:hover .site-name,
  .site-row:focus-visible .site-name {
    color: var(--accent);
  }

  .project-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .supporting-project,
  .site-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    border-top: 1px solid var(--card-border);
    padding-block: 1.25rem;
  }

  .supporting-project:last-child,
  .site-row:last-child {
    border-bottom: 1px solid var(--card-border);
  }

  .project-name,
  .post-title {
    overflow-wrap: anywhere;
  }

  .writing-row:hover .post-title,
  .writing-row:focus-visible .post-title {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  @media (min-width: 48rem) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .project-grid > li + li {
      border-top: 0;
      border-left: 1px solid var(--card-border);
    }

    .project-card {
      padding: 1.75rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line > span {
      animation: none;
      transform: none;
    }

    .text-link,
    .project-card {
      transition: none;
    }
  }
</style>
