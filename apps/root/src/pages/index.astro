---
import Layout from "@/components/Layout.astro";
import { copyrightText } from "@zrr-website/site-meta";

const vision =
  "长期致力于推动基础设施走向个人化与可定制，使每个人都能按照自身目标和工作方式构造、验证并演化自己的系统；持续探索可编程基础设施、可组合运行时与人机协作编程模型。";

const sites = [
  {
    name: "博客",
    domain: "blog.zrr.dev",
    href: "https://blog.zrr.dev",
    description:
      "学习笔记、技术文章和项目经验。最近在写解析器、等价饱和与符号计算。",
  },
  {
    name: "幻灯片",
    domain: "slides.zrr.dev",
    href: "https://slides.zrr.dev",
    description: "技术演讲、课程分享，以及项目汇报的幻灯片合集。",
  },
  {
    name: "GitHub",
    domain: "github.com/zrr1999",
    href: "https://github.com/zrr1999",
    description: "开源项目、代码贡献和一些实验性质的仓库。",
  },
];

const projects = [
  {
    name: "spore",
    description:
      "意图编程语言（实验阶段）：以函数签名统一表达类型、可失败结果与 effect，允许带 hole 的未完整程序通过编译，作为人机协作协议。",
    href: "https://github.com/spore-lang/spore",
    tags: ["Rust", "Language"],
  },
  {
    name: "volvox",
    description:
      "可组合性深度学习元框架（探索阶段），在调研主流框架与编译器后重新设计的可扩展框架。",
    href: "https://github.com/volvox-ai/volvox",
    tags: ["Python", "DL Framework"],
  },
  {
    name: "cue",
    description:
      "持久、可观察的统一命令执行底座，支持断线恢复、共享 session 与多观察者 PTY。",
    href: "https://github.com/zendev-lab/cue",
    tags: ["Rust", "Runtime"],
  },
  {
    name: "spark",
    description:
      "本地优先的持久化编码智能体：本地 daemon 托管会话、执行与恢复，支撑长期任务与跨工作区委托。",
    href: "https://github.com/zendev-lab/spark",
    tags: ["TypeScript", "Agent"],
  },
  {
    name: "emotion-recognition",
    description:
      "多模态情绪识别系统（硕士毕业设计），覆盖文本、音频、视频三模态的情绪分类与情感分析。",
    href: "https://github.com/zrr1999/emotion-recognition",
    tags: ["Python", "ML"],
  },
];

const friends = [
  { name: "时雨梦之零", url: "https://nyakku.moe/" },
  { name: "Hi, gouzi", url: "https://www.gouzill.com/" },
  { name: "Jack's Blog", url: "https://www.jackzhu.top/" },
];

const friendExchangeInfo = `{ "name": "六个骨头", "url": "https://zrr.dev" }`;

const education = [
  { degree: "学士", major: "智能科学与技术", years: "2018–2022" },
  { degree: "硕士", major: "计算机科学与技术", years: "2022–2025" },
];

interface Post {
  title: string;
  href: string;
  date: string;
}

/** 构建期从博客 RSS 拉取最新文章；失败时静默降级，不阻断构建。 */
async function fetchRecentPosts(limit = 4): Promise<Post[]> {
  try {
    const res = await fetch("https://blog.zrr.dev/rss.xml");
    if (!res.ok) return [];
    const xml = await res.text();
    const pick = (item: string, tag: string) =>
      item.match(new RegExp(`<${tag}>([\\s\\S]*?)</${tag}>`))?.[1]?.trim() ??
      "";
    return [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)]
      .slice(0, limit)
      .map(m => {
        const item = m[1];
        const d = new Date(pick(item, "pubDate"));
        return {
          title: pick(item, "title"),
          href: pick(item, "link"),
          date: Number.isNaN(d.getTime()) ? "" : d.toISOString().slice(0, 10),
        };
      })
      .filter(p => p.title && p.href);
  } catch {
    return [];
  }
}

const posts = await fetchRecentPosts();
---

<Layout ambient={false}>
  <header
    class="fixed inset-x-0 top-0 z-10 border-b border-(--card-border) bg-(--bg)/85 backdrop-blur"
  >
    <div
      class="mx-auto flex max-w-6xl items-baseline justify-between px-5 py-4 md:px-8"
    >
      <a href="/" class="mono text-sm font-semibold tracking-tight text-(--fg)">
        zrr<span class="text-(--subtle)">.dev</span>
      </a>
      <nav class="mono flex gap-5 text-xs text-(--muted) md:gap-7">
        <a class="nav-link" href="https://blog.zrr.dev">博客</a>
        <a class="nav-link" href="https://slides.zrr.dev">幻灯片</a>
        <a class="nav-link" href="/about">关于</a>
        <a class="nav-link" href="https://github.com/zrr1999">GitHub</a>
        <a class="nav-link" href="https://blog.zrr.dev/rss.xml">RSS</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-5 pt-28 pb-16 md:px-8 md:pt-36">
    <section class="reveal">
      <div class="grid items-end gap-10 md:grid-cols-[1fr_250px]">
        <div>
          <h1
            class="display-font text-[clamp(3.6rem,13vw,10.5rem)] leading-[0.92] font-bold tracking-[-0.035em] text-(--fg) uppercase"
          >
            <span class="hero-line"><span>Zhan</span></span>
            <span class="hero-line hero-line--accent text-right">
              <span>Rongrui</span>
            </span>
          </h1>
          <p
            class="mt-8 max-w-2xl text-base leading-relaxed text-(--muted) md:text-lg"
          >
            {vision}
          </p>
        </div>

        <aside class="mono text-xs leading-loose text-(--muted)">
          <span
            class="mb-3 block text-[11px] tracking-[0.14em] text-(--subtle) uppercase"
          >
            Education
          </span>
          <p class="mb-2 text-sm font-semibold tracking-wide text-(--fg)">
            西安电子科技大学
          </p>
          {
            education.map(e => (
              <p class="flex items-baseline justify-between gap-3">
                <span>
                  <span class="mr-2 text-(--accent)">{e.degree}</span>
                  {e.major}
                </span>
                <span class="text-(--subtle)">{e.years}</span>
              </p>
            ))
          }
        </aside>
      </div>
    </section>

    <section class="reveal reveal-2 mt-20 md:mt-24">
      <div class="flex items-baseline justify-between gap-6">
        <h2
          class="mono text-xs tracking-[0.18em] text-(--subtle) uppercase"
        >
          <span class="mr-2 font-medium text-(--accent)">01</span>站点 / Index
        </h2>
        <span class="text-xs text-(--subtle)">持续更新中</span>
      </div>

      <div class="mt-4">
        {
          sites.map(site => (
            <a
              href={site.href}
              class="group grid grid-cols-[1fr_auto] items-center gap-6 border-t border-(--card-border) py-7 transition-[padding] duration-300 last:border-b hover:pl-4"
            >
              <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1">
                <span class="display-font text-3xl font-bold tracking-tight text-(--fg) transition-colors duration-300 group-hover:text-(--accent) md:text-4xl">
                  {site.name}
                </span>
                <span class="mono text-xs text-(--subtle)">{site.domain}</span>
                <span class="basis-full text-sm text-(--muted)">
                  {site.description}
                </span>
              </div>
              <span
                class="text-2xl text-(--subtle) transition-all duration-300 group-hover:translate-x-1.5 group-hover:-translate-y-1.5 group-hover:text-(--accent)"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section id="projects" class="reveal reveal-2 mt-20 md:mt-24">
      <div class="flex items-baseline justify-between gap-6">
        <h2
          class="mono text-xs tracking-[0.18em] text-(--subtle) uppercase"
        >
          <span class="mr-2 font-medium text-(--accent)">02</span>开源项目 /
          Projects
        </h2>
        <a
          href="https://github.com/zrr1999"
          class="mono hidden text-xs text-(--subtle) transition-colors hover:text-(--fg) md:inline"
        >
          在 GitHub 查看更多 →
        </a>
      </div>

      <div class="mt-4">
        {
          projects.map(project => (
            <a
              href={project.href}
              class="group grid grid-cols-[1fr_auto] items-center gap-6 border-t border-(--card-border) py-6 transition-[padding] duration-300 last:border-b hover:pl-4"
            >
              <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1">
                <span class="mono text-xl font-semibold tracking-tight text-(--fg) transition-colors duration-300 group-hover:text-(--accent) md:text-2xl">
                  {project.name}
                </span>
                <span class="mono text-xs text-(--subtle)">
                  {project.tags.join(" / ")}
                </span>
                <span class="basis-full text-sm text-(--muted)">
                  {project.description}
                </span>
              </div>
              <span
                class="text-xl text-(--subtle) transition-all duration-300 group-hover:translate-x-1.5 group-hover:-translate-y-1.5 group-hover:text-(--accent)"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </section>

    {
      posts.length > 0 && (
        <section class="reveal reveal-3 mt-20 md:mt-24">
          <div class="flex items-baseline justify-between gap-6">
            <h2 class="mono text-xs tracking-[0.18em] text-(--subtle) uppercase">
              <span class="mr-2 font-medium text-(--accent)">03</span>最近文章 /
              Writing
            </h2>
            <span class="mono text-xs text-(--subtle)">via RSS</span>
          </div>

          <div class="mt-4">
            {posts.map(post => (
              <a
                href={post.href}
                class="group grid grid-cols-[1fr_auto] items-baseline gap-2 border-t border-(--card-border) py-4 last:border-b md:grid-cols-[120px_1fr_auto] md:gap-6"
              >
                <span class="mono col-span-2 text-xs text-(--subtle) md:col-span-1">
                  {post.date}
                </span>
                <span class="post-title text-[15px] font-medium text-(--fg)">
                  {post.title}
                </span>
                <span
                  class="hidden text-sm text-(--subtle) transition-all duration-300 group-hover:translate-x-1 group-hover:text-(--accent) md:inline"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            ))}
          </div>

          <a
            href="https://blog.zrr.dev"
            class="group mono mt-6 inline-block text-xs text-(--muted) transition-colors hover:text-(--accent)"
          >
            所有文章
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">
              →
            </span>
          </a>
        </section>
      )
    }

    <section class="reveal reveal-3 mt-20 md:mt-24">
      <h2 class="mono text-xs tracking-[0.18em] text-(--subtle) uppercase">
        <span class="mr-2 font-medium text-(--accent)">04</span>友链 / Friends
      </h2>
      <div class="mt-4 border-t border-(--card-border) pt-5">
        <p class="flex flex-wrap items-baseline gap-y-2 text-sm">
          {
            friends.map((friend, i) => (
              <>
                {i > 0 && <span class="mx-3 text-(--card-border)">/</span>}
                <a
                  href={friend.url}
                  class="friend-link text-(--muted) transition-colors hover:text-(--accent)"
                >
                  <sup class="mono mr-1 text-[10px] text-(--subtle)">
                    {String(i + 1).padStart(2, "0")}
                  </sup>
                  {friend.name}
                </a>
              </>
            ))
          }
        </p>
        <p class="mt-5 max-w-2xl text-xs leading-relaxed text-(--subtle)">
          互换友链欢迎直接
          <a
            href="https://github.com/zrr1999/zrr.dev/edit/main/apps/root/src/pages/index.astro"
            class="text-(--muted) underline decoration-(--card-border) underline-offset-4 transition-colors hover:text-(--accent)"
            >提 PR</a
          >
          或写信至
          <a
            href="mailto:me@zrr.dev"
            class="text-(--muted) underline decoration-(--card-border) underline-offset-4 transition-colors hover:text-(--accent)"
            >me@zrr.dev</a
          >，附上你的站点信息；标准：先友后链、内容以原创为主、站点使用 HTTPS。
        </p>
        <pre
          class="mono mt-3 max-w-2xl overflow-x-auto border border-(--card-border) px-4 py-3 text-xs text-(--muted)"
        >{friendExchangeInfo}</pre>
      </div>
    </section>

    <footer
      class="mono mt-24 flex flex-wrap items-baseline justify-between gap-3 border-t border-(--card-border) pt-6 text-xs text-(--subtle)"
    >
      <span>{copyrightText()}</span>
      <span>
        <a
          href="https://blog.zrr.dev/rss.xml"
          class="transition-colors hover:text-(--fg)">RSS</a
        >
        <span class="mx-2">·</span>
        <a
          href="https://github.com/zrr1999"
          class="transition-colors hover:text-(--fg)">GitHub</a
        >
      </span>
    </footer>
  </main>
</Layout>

<style>
  .mono {
    font-family:
      "IBM Plex Mono",
      "Noto Sans SC",
      ui-monospace,
      monospace;
  }

  .hero-line {
    display: block;
    overflow: hidden;
  }
  .hero-line > span {
    display: block;
    transform: translateY(110%);
    animation: hero-rise 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-line--accent > span {
    color: var(--accent);
    animation-delay: 0.12s;
  }
  @keyframes hero-rise {
    to {
      transform: translateY(0);
    }
  }

  .nav-link {
    position: relative;
    transition: color 0.25s ease;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link:hover {
    color: var(--fg);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .post-title {
    width: fit-content;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: left calc(100% - 2px);
    transition:
      background-size 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.25s ease;
  }
  a:hover .post-title {
    background-size: 100% 1px;
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .reveal-2,
    .reveal-3,
    .hero-line > span {
      animation: none !important;
      transform: none !important;
    }
  }
</style>
