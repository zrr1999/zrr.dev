---
import Layout from "@/components/Layout.astro";
import Header from "@/components/Header.astro";
import PageContent from "@/components/PageContent.astro";
import BentoGrid from "@/components/BentoGrid.astro";
import BentoCell from "@/components/BentoCell.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import CopySnippet from "@/components/CopySnippet";
import { SITE_AUTHOR } from "@zrr-website/site-meta";
import { friends } from "@/friends";

const githubEdit =
  "https://github.com/zrr1999/zrr.dev/edit/main/apps/root/src/friends.ts";

const mySite = JSON.stringify(
  {
    name: SITE_AUTHOR,
    url: "https://zrr.dev",
    desc: `${SITE_AUTHOR}的个人主页`,
    avatar:
      "https://raw.githubusercontent.com/zrr1999/hosting/main/images/profile/personal/avatar.png",
  },
  null,
  2,
);

const yourSite = JSON.stringify(
  { name: "你的网站", url: "https://example.com" },
  null,
  2,
);

const steps: {
  title: string;
  detail: string;
  code?: string;
  link?: { href: string; text: string };
}[] = [
  {
    title: "先友后链",
    detail:
      "在你的站点添加本站链接。下面是本站信息，字段可按需取用；提交到本站时只要 name 与 url。",
    code: mySite,
  },
  {
    title: "提交到 GitHub",
    detail:
      "在友链列表里追加你的站点。打开 GitHub 上的编辑页即可，对应文件是 apps/root/src/friends.ts。",
    code: yourSite,
    link: {
      href: githubEdit,
      text: "在 GitHub 上提交站点",
    },
  },
  {
    title: "等待合入",
    detail:
      "PR 合入后会自动部署，首页与本页同时更新。没有 GitHub 账号需要先注册并 fork；若 PR 未合入，可以发邮件到 me@zrr.dev 说明。",
  },
];

const criteria = ["内容以原创为主，转载内容尽可能少", "站点使用 HTTPS"];
---

<Layout
  title={`友链 — ${SITE_AUTHOR}`}
  description="朋友们的站点，以及互换友链的方式与标准。"
>
  <Header />

  <PageContent>
    <BentoGrid>
      <BentoCell
        tone="tint"
        span="col-span-1 md:col-span-6 lg:col-span-12"
        delay={0}
      >
        <h1
          class="display-font text-[clamp(2.6rem,7vw,5.5rem)] leading-[0.95] font-bold tracking-[-0.03em]"
        >
          友链
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-(--muted) md:text-lg">
          朋友们的站点。想出现在名单里，先在你那边放上本站，再通过 GitHub 提交。
        </p>
        <a href="#exchange" class="text-link mt-4 font-medium">互换方式</a>
      </BentoCell>

      {
        friends.map((friend, index) => (
          <BentoCell
            href={friend.url}
            tone="plain"
            span="col-span-1 md:col-span-2 lg:col-span-4"
            delay={1 + index}
          >
            <h2 class="text-lg font-semibold tracking-tight">{friend.name}</h2>
            <p class="mono bento-muted mt-2 text-xs break-all">
              {new URL(friend.url).host}
            </p>
            <p class="bento-muted mt-auto pt-6 text-right text-lg" aria-hidden="true">
              ↗
            </p>
          </BentoCell>
        ))
      }

      <BentoCell
        id="exchange"
        tone="tint"
        label="互换"
        span="col-span-1 md:col-span-6 lg:col-span-12"
        delay={4}
      >
        <p class="max-w-2xl text-sm leading-relaxed text-(--muted)">
          先友后链：你的站点放上本站之后，再把你的站点提交过来。
        </p>
        <ul class="mt-3 max-w-2xl list-disc space-y-1 pl-5 text-sm leading-relaxed text-(--muted)">
          {criteria.map(item => <li>{item}</li>)}
        </ul>
        <div class="mt-4">
          {
            steps.map(step => (
              <div class="border-t border-(--card-border) py-5 first:border-t-0 first:pt-0 last:pb-0">
                <h3 class="text-[15px] font-medium">{step.title}</h3>
                <p class="mt-1 max-w-2xl text-sm leading-relaxed text-(--muted)">
                  {step.detail}
                </p>
                {step.code && (
                  <div class="relative mt-3 max-w-2xl">
                    <div class="absolute top-2.5 right-3">
                      <CopySnippet client:load text={step.code} />
                    </div>
                    <pre class="code-sample mono pr-14">
{step.code}</pre>
                  </div>
                )}
                {step.link && (
                  <a href={step.link.href} class="text-link mt-2 text-sm">
                    {step.link.text} ↗
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </BentoCell>
    </BentoGrid>

    <SiteFooter showHome />
  </PageContent>
</Layout>
